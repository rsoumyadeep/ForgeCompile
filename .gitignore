*.o
*.obj
*.exe
*.pdb
*.ll.tmp
/out/

# --- Experiments ---------------------------------------------------------------
# Individual run directories are large/noisy; curated results are copied into
# experiments/<EXP-ID>/ and docs/RESULTS.md explicitly.
experiments/runs/*
!experiments/runs/.gitkeep
# Generated ML/RL datasets: reproducible from their config + git commit (ml/data_pipeline.py).
experiments/data/

