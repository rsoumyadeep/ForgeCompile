// Euclid's algorithm (iterative and recursive) and least common multiple.

fn gcd(a: int, b: int) -> int {
    while b != 0 {
        let t = b;
        b = a % b;
        a = t;
    }
    return a;
}

fn gcd_recursive(a: int, b: int) -> int {
    if b == 0 {
        return a;
    }
    return gcd_recursive(b, a % b);
}

fn lcm(a: int, b: int) -> int {
    return a / gcd(a, b) * b;
}

fn main() -> int {
    print(gcd(1071, 462));
    print(gcd_recursive(1071, 462));
    print(lcm(21, 6));
    print(gcd(17, 5) == 1);
    return 0;
}
