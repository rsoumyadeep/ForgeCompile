// Recursive and iterative Fibonacci: function calls, if/else, while loops.

fn fib_recursive(n: int) -> int {
    if n < 2 {
        return n;
    }
    return fib_recursive(n - 1) + fib_recursive(n - 2);
}

fn fib_iterative(n: int) -> int {
    let a = 0;
    let b = 1;
    let i = 0;
    while i < n {
        let next = a + b;
        a = b;
        b = next;
        i = i + 1;
    }
    return a;
}

fn main() -> int {
    for n in 0..15 {
        print(fib_recursive(n));
    }
    print(fib_iterative(50));
    return 0;
}
