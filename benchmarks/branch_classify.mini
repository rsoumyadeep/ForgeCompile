// branch_classify -- branch-heavy: data-dependent if/else chains on a
// pseudo-random sequence. Exercises: branch structure, simplifycfg, sccp.
fn main() -> int {
    let reps = 10; // @size small=1 large=8000
    let a = 0;
    let b = 0;
    let c = 0;
    let d = 0;
    let x = 12345;
    for r in 0..reps {
        for i in 0..10000 {
            x = (x * 1103 + 12345) % 65536;
            let v = x % 1000;
            if v < 100 {
                a = a + 1;
            } else if v < 300 {
                b = b + v % 7;
            } else if v % 2 == 0 {
                c = c + 2;
            } else {
                d = d - 1;
            }
        }
    }
    print(a);
    print(b);
    print(c);
    print(d);
    return 0;
}
