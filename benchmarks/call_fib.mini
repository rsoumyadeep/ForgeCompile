// call_fib -- call-heavy: naive recursive Fibonacci. Recursive, so never
// inlined; measures call overhead and what the passes can do around calls.
fn fib(n: int) -> int {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() -> int {
    let reps = 1; // @size small=1 large=24000
    let total = 0;
    for r in 0..reps {
        total = total + fib(18 + r % 3);
    }
    print(total);
    return 0;
}
